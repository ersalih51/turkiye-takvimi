<Window x:Class="TurkiyeTakvimi.Arayuz.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:yerel="clr-namespace:TurkiyeTakvimi.Arayuz"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Türkiye Takvimi" Width="820" Height="860" MinWidth="460" MinHeight="520"
        WindowStartupLocation="CenterScreen" FontSize="16" Icon="Varliklar/uygulama.ico"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        PreviewKeyDown="Pencere_PreviewKeyDown"
        PreviewMouseWheel="Pencere_PreviewMouseWheel">

    <Window.Resources>
        <!-- Menüler yazı boyutu ölçeğine göre büyür (açılır menüler dönüştürmeden etkilenmediği için yazı boyutuyla ölçeklenir). -->
        <sys:Double x:Key="MenuYaziBoyutu">16</sys:Double>

        <FontFamily x:Key="BaslikYazisi">Segoe UI Variable Display, Segoe UI</FontFamily>

        <!-- Kart görünümlü liste öğesi: seçili/odaklı öğede vurgu renginde çerçeve (klavye odağı net görünür). -->
        <Style x:Key="KartOgesi" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <ContentPresenter/>
                            <Border x:Name="Halka" CornerRadius="10" BorderThickness="2" Visibility="Collapsed"
                                    IsHitTestVisible="False"
                                    BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Seçili öğe her zaman hafif çerçeveli; klavye odağı o listedeyse çerçeve tam parlak olur. -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Halka" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Halka" Property="Opacity" Value="0.3"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="Selector.IsSelectionActive" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Halka" Property="Opacity" Value="1"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Çizelge türü seçenekleri: yuvarlak köşeli düğme görünümlü radyo düğmeleri (ok tuşlarıyla geçilir). -->
        <Style x:Key="CizelgeSecenegi" TargetType="RadioButton">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Kutu" CornerRadius="17" BorderThickness="2" Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <ContentPresenter x:Name="Yazi" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Kutu" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter TargetName="Kutu" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Kutu" Property="BorderBrush" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True"/>
                                    <Condition Property="IsKeyboardFocused" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Kutu" Property="BorderBrush" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                            </MultiTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Kutu" Property="Opacity" Value="0.88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- İmsakiye satırı için liste öğesi: sıkı aralık, seçili öğede vurgu halkası. -->
        <Style x:Key="ImsakiyeOgesi" TargetType="ListBoxItem" BasedOn="{StaticResource KartOgesi}">
            <Setter Property="Margin" Value="0,0,0,3"/>
            <Setter Property="AutomationProperties.PositionInSet" Value="0"/>
            <Setter Property="AutomationProperties.SizeOfSet" Value="0"/>
        </Style>

        <!-- Takvim sekmesindeki olay listesi: aynı görünüm, sıra numarası ekran okuyucuya bildirilmez. -->
        <Style x:Key="MetinOgesi" TargetType="ListBoxItem" BasedOn="{StaticResource KartOgesi}">
            <Setter Property="Margin" Value="4,4,4,0"/>
            <Setter Property="AutomationProperties.PositionInSet" Value="0"/>
            <Setter Property="AutomationProperties.SizeOfSet" Value="0"/>
        </Style>

        <!-- Vakit satırı: ad solda, saat sağda; sıradaki vakitte rozet ve vurgu, geçmiş vakitlerde hafif soluk yazı. -->
        <DataTemplate x:Key="VakitSablonu">
            <Grid>
                <Border CornerRadius="10" BorderThickness="1"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"/>
                <Border x:Name="Vurgu" CornerRadius="10" Visibility="Collapsed" Opacity="0.18"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"/>
                <Border x:Name="Serit" Visibility="Collapsed" Width="5" HorizontalAlignment="Left" CornerRadius="3"
                        Margin="7,12,0,12" Background="{DynamicResource AccentFillColorDefaultBrush}"/>
                <Grid Margin="24,9,20,9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="Ad" Text="{Binding Ad}" FontSize="20" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,18,0" VerticalAlignment="Center">
                        <Border x:Name="Rozet" Visibility="Collapsed" CornerRadius="11" Padding="11,3"
                                Background="{DynamicResource AccentFillColorDefaultBrush}">
                            <TextBlock Text="Sıradaki" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                        </Border>
                        <Border x:Name="BildirimRozeti" Visibility="Collapsed" CornerRadius="11" Padding="11,3" Margin="8,0,0,0"
                                BorderThickness="1" BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}">
                            <TextBlock Text="Bildirim" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        </Border>
                        <Border x:Name="YarinRozeti" Visibility="Collapsed" CornerRadius="11" Padding="11,3" Margin="8,0,0,0"
                                BorderThickness="1" BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}">
                            <TextBlock Text="Yarın" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="Saat" Grid.Column="2" Text="{Binding Saat}" FontSize="24" FontWeight="SemiBold"
                               FontFamily="{StaticResource BaslikYazisi}" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Siradaki}" Value="True">
                    <Setter TargetName="Vurgu" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Serit" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Rozet" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Ad" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Yarin}" Value="True">
                    <Setter TargetName="YarinRozeti" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Bildirilecek}" Value="True">
                    <Setter TargetName="BildirimRozeti" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Gecti}" Value="True"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Ad" Property="Opacity" Value="0.72"/>
                    <Setter TargetName="Saat" Property="Opacity" Value="0.72"/>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Haftalık görünüm: her gün bir kart; ana vakitler kartın içinde yan yana (dar pencerede alt satıra sarar). -->
        <DataTemplate x:Key="GunSablonu">
            <Grid>
                <Border CornerRadius="10" BorderThickness="1"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"/>
                <Border x:Name="Vurgu" CornerRadius="10" Visibility="Collapsed" Opacity="0.18"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"/>
                <Border x:Name="Serit" Visibility="Collapsed" Width="5" HorizontalAlignment="Left" CornerRadius="3"
                        Margin="7,12,0,12" Background="{DynamicResource AccentFillColorDefaultBrush}"/>
                <StackPanel Margin="24,10,20,8">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Baslik}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border x:Name="Rozet" Visibility="Collapsed" CornerRadius="11" Padding="11,3" Margin="12,0,0,0"
                                VerticalAlignment="Center" Background="{DynamicResource AccentFillColorDefaultBrush}">
                            <TextBlock Text="Bugün" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                        </Border>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Hucreler}" Margin="0,6,0,0" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Width="88" Margin="0,0,4,4">
                                    <TextBlock Text="{Binding Ad}" FontSize="14" Opacity="0.82"/>
                                    <TextBlock Text="{Binding Saat}" FontSize="21" FontWeight="SemiBold"
                                               FontFamily="{StaticResource BaslikYazisi}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Bugun}" Value="True">
                    <Setter TargetName="Vurgu" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Serit" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Rozet" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- İmsakiye satırı: Ramazan günü, tarih, hafta günü ve sekiz vakit sütun sütun. İmsak ve Akşam (oruç başlar / iftar) vurgulu.
             Sütun genişlikleri başlık satırıyla (Imsakiye sekmesindeki ImsakiyeBasligi) aynı olmalıdır. -->
        <DataTemplate x:Key="ImsakiyeSablonu">
            <Grid>
                <Border CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"/>
                <Border x:Name="Vurgu" CornerRadius="8" Visibility="Collapsed" Opacity="0.18"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"/>
                <Border x:Name="Serit" Visibility="Collapsed" Width="4" HorizontalAlignment="Left" CornerRadius="2"
                        Margin="3,8,0,8" Background="{DynamicResource AccentFillColorDefaultBrush}"/>
                <Grid Margin="10,6,10,6" MinWidth="540">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="84"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Gun}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding TarihMetni}" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock x:Name="KadirYazisi" Text="Kadir Gecesi" FontSize="12" Visibility="Collapsed"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding HaftaGunu}" FontSize="14" Opacity="0.8" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <ItemsControl Grid.Column="3" ItemsSource="{Binding Hucreler}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock x:Name="Saat" Text="{Binding Saat}" FontSize="16" HorizontalAlignment="Center"
                                           FontFamily="{StaticResource BaslikYazisi}"/>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Vurgulu}" Value="True">
                                        <Setter TargetName="Saat" Property="FontWeight" Value="Bold"/>
                                        <Setter TargetName="Saat" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Bugun}" Value="True">
                    <Setter TargetName="Vurgu" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Serit" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding KadirGecesi}" Value="True">
                    <Setter TargetName="KadirYazisi" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Aylık çizelge satırı: ayın günü, tarih, hafta günü ve yedi ana vakit. Bugün vurgulu, Cuma günü hafta günü kalın. -->
        <DataTemplate x:Key="AylikSablonu">
            <Grid>
                <Border CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"/>
                <Border x:Name="Vurgu" CornerRadius="8" Visibility="Collapsed" Opacity="0.18"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"/>
                <Border x:Name="Serit" Visibility="Collapsed" Width="4" HorizontalAlignment="Left" CornerRadius="2"
                        Margin="3,6,0,6" Background="{DynamicResource AccentFillColorDefaultBrush}"/>
                <Grid Margin="10,5,10,5" MinWidth="540">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="96"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Gun}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding TarihMetni}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock x:Name="GunAdi" Grid.Column="2" Text="{Binding HaftaGunu}" FontSize="14" Opacity="0.8"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <ItemsControl Grid.Column="3" ItemsSource="{Binding Hucreler}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Saat}" FontSize="16" HorizontalAlignment="Center"
                                           FontFamily="{StaticResource BaslikYazisi}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Bugun}" Value="True">
                    <Setter TargetName="Vurgu" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Serit" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Cuma}" Value="True">
                    <Setter TargetName="GunAdi" Property="FontWeight" Value="Bold"/>
                    <Setter TargetName="GunAdi" Property="Opacity" Value="1"/>
                    <Setter TargetName="GunAdi" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="ParagrafSablonu">
            <TextBlock Text="{Binding}" TextWrapping="Wrap" Padding="12,10" FontSize="17"/>
        </DataTemplate>

        <!-- Salt okunur metin alanları (Söz, Arka Yaprak, Tarih ve Günün Bilgileri): kopyala, tümünü seç, paylaş. -->
        <ContextMenu x:Key="OkunurMetinMenusu" x:Shared="False" FontSize="{DynamicResource MenuYaziBoyutu}">
            <MenuItem Header="_Kopyala" InputGestureText="Ctrl+C" Command="ApplicationCommands.Copy"/>
            <MenuItem Header="_Tümünü seç" InputGestureText="Ctrl+A" Command="ApplicationCommands.SelectAll"/>
            <MenuItem Header="_Paylaş…" Click="PaylasMetin_Click"/>
        </ContextMenu>

        <!-- Başlığın sağında küçük, soluk kısayol ipucu (görenler için; ekran okuyucu kısayolu denetimin kendisinden okur). -->
        <Style x:Key="KisayolIpucu" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="0,0,4,6"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>

        <Style x:Key="BolumEtiketi" TargetType="Label">
            <Setter Property="Padding" Value="2,0,0,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>

        <!-- Vurgulu kartın içindeki salt okunur metin: sade şablon, odakta belirgin beyaz çerçeve. -->
        <Style x:Key="KartMetni" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
            <Setter Property="SelectionBrush" Value="#66FFFFFF"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Cerceve" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent"
                                Padding="6,4">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Cerceve" Property="BorderBrush"
                                        Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Salt okunur metin alanları: kart görünümü (köşeler liste kartlarıyla aynı), klavye odağında belirgin vurgu çerçevesi. -->
        <Style x:Key="OkunurAlan" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="IsReadOnlyCaretVisible" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentFillColorSelectedTextBackgroundBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border CornerRadius="10" BorderThickness="1" Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"/>
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                            <Border x:Name="Halka" CornerRadius="10" BorderThickness="2" Visibility="Collapsed"
                                    IsHitTestVisible="False"
                                    BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Halka" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Menü çubuğuna Alt/F10 ile girilir; Tab sırasına girmez (sayfadaki öğeler Tab ile gezilir). -->
        <Menu DockPanel.Dock="Top" FontSize="{DynamicResource MenuYaziBoyutu}" AutomationProperties.Name="Ana menü" KeyboardNavigation.TabNavigation="None">
            <!-- Şehir menüsü: son kullanılan şehirler (MainWindow.Sehirler.cs doldurur) ve "Başka şehir seç…". Ctrl+K açar. -->
            <MenuItem x:Name="SehirMenusu" Header="Ye_r"/>
            <MenuItem Header="_Görünüm">
                <MenuItem Header="_Vakitler" InputGestureText="Ctrl+1" Click="AnaSekme_Click"/>
                
                <MenuItem Header="_Takvim" InputGestureText="Ctrl+2" Click="TakvimSekme_Click"/>
                <MenuItem Header="_Diğer Vakitler" InputGestureText="Ctrl+3" Click="DigerSekme_Click"/>
                <MenuItem Header="_Haftalık" InputGestureText="Ctrl+4" Click="HaftaSekme_Click"/>
                <MenuItem Header="Ay_lık" InputGestureText="Ctrl+5" Click="AylikSekme_Click"/>
                <MenuItem Header="_İmsakiye" InputGestureText="Ctrl+6" Click="ImsakiyeSekme_Click"/>
                <Separator/>
                <MenuItem Header="T_ema">
                    <MenuItem x:Name="TemaSistem" Header="_Sistem temasını kullan" IsCheckable="True" Click="TemaSistem_Click"/>
                    <MenuItem x:Name="TemaAcik" Header="_Açık tema" IsCheckable="True" Click="TemaAcik_Click"/>
                    <MenuItem x:Name="TemaKoyu" Header="_Koyu tema" IsCheckable="True" Click="TemaKoyu_Click"/>
                </MenuItem>
                <MenuItem Header="Yazı _boyutu">
                    <MenuItem Header="_Büyüt" InputGestureText="Ctrl+Artı" Click="Buyut_Click"/>
                    <MenuItem Header="_Küçült" InputGestureText="Ctrl+Eksi" Click="Kucult_Click"/>
                    <MenuItem Header="_Normal boyut" InputGestureText="Ctrl+0" Click="NormalBoyut_Click"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Yenile" InputGestureText="F5" Click="Yenile_Click"/>
            </MenuItem>

            <!-- Bilgiler: önce Mübarek Gün ve Geceler, sonra turktakvim.com'un Bilgiler sayfasındaki kategoriler (MainWindow.Bilgiler.cs).
                 Alt+B Takvim'deki bir alana ait olduğu için Alt+L. -->
            <MenuItem Header="Bi_lgiler">
                <MenuItem Header="_Mübarek Gün ve Geceler…" InputGestureText="Ctrl+M" Click="MubarekGunler_Click"/>
                <Separator/>
                <MenuItem Header="Takvim ve Vakit Bilgileri" Tag="takvim ve|Takvim ve Vakit Bilgileri" Click="BilgiKategorisi_Click"/>
                <MenuItem Header="Namaz Vakti Bilgileri" Tag="namaz|Namaz Vakti Bilgileri" Click="BilgiKategorisi_Click"/>
                <MenuItem Header="Dinî Bilgiler" Tag="dini|Dinî Bilgiler" Click="BilgiKategorisi_Click"/>
                <MenuItem Header="Düânın Önemi ve Kıymetli Düâlar" Tag="duanin|Düânın Önemi ve Kıymetli Düâlar" Click="BilgiKategorisi_Click"/>
                <MenuItem Header="Diğer Kıymetli Düâlar" Tag="diger kiymetli|Diğer Kıymetli Düâlar" Click="BilgiKategorisi_Click"/>
                <MenuItem Header="Diğer Bilgiler" Tag="diger bilgiler|Diğer Bilgiler" Click="BilgiKategorisi_Click"/>
                <MenuItem Header="Mektûbât Tercemesi" Tag="mektubat|Mektûbât Tercemesi" Click="BilgiKategorisi_Click"/>
            </MenuItem>
            <!-- Ayarlar: genel ayarlar penceresi, bildirim ayarları ve çevrimdışı veri bölümü. -->
            <MenuItem Header="A_yarlar">
                <MenuItem Header="_Genel ayarlar…" InputGestureText="Ctrl+Virgül" Click="AyarlarGenel_Click"/>
                <MenuItem Header="_Bildirim ayarları…" Click="AyarlarBildirim_Click"/>
                <MenuItem Header="Çevrimdışı _veri…" Click="AyarlarCevrimdisi_Click"/>
            </MenuItem>
            <MenuItem Header="Yar_dım">
                <MenuItem Header="_Kullanım Kılavuzu" InputGestureText="F1" Click="Kilavuz_Click"/>
                <MenuItem Header="Klavye Kı_sayolları" InputGestureText="Ctrl+F1" Click="Kisayollar_Click"/>
                <Separator/>
                <MenuItem Header="Hoş _geldiniz" Click="Karsilama_Click"/>
                <MenuItem Header="_Hakkında" Click="Hakkinda_Click"/>
                <MenuItem Header="Güncellemeleri _denetle…" Click="Guncelleme_Click"/>
                <MenuItem Header="Geri _bildirim gönder…" Click="GeriBildirim_Click"/>
                <Separator/>
                <MenuItem Header="Ç_ıkış" InputGestureText="Ctrl+Q" Click="Cikis_Click"/>
            </MenuItem>
        </Menu>

        <DockPanel x:Name="Kok">
        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" Padding="24,8,24,10"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <TextBlock x:Name="Durum" TextWrapping="Wrap" FontSize="15"
                       AutomationProperties.LiveSetting="Polite"/>
        </Border>

        <TabControl x:Name="Sekmeler" Margin="12,8,12,0" AutomationProperties.Name="Bölümler"
                    SelectionChanged="Sekmeler_SelectionChanged">
            <TabItem x:Name="AnaSekme" Header="Vakitler" FontSize="16" Padding="14,9">
                <!-- Tab sırası: vakit listesi, sıradaki vakte kalan süre. (Yenile: Görünüm menüsü ve F5.) Odaklanabilir kontroller
                     aynı ızgaranın doğrudan çocuğudur; geri sayım kartı bu yüzden "süs katmanı" + üstündeki metin kutusu olarak kurulmuştur. -->
                <!-- Büyük yazı boyutunda sayfa küçülüp liste ezilmesin: liste en az 330 piksel yüksekliğinde kalır, sığmazsa sayfa kaydırılır. -->
                <ScrollViewer x:Name="AnaKaydirma" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False" ScrollChanged="AnaKaydirma_ScrollChanged">
                <Grid x:Name="AnaIzgara" Margin="16,14,16,8" MaxWidth="760">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="330"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Başlık: şehir ve tarih solda, canlı saat sağda (süs amaçlı simge ekran okuyucuya görünmez) -->
                    <Grid Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="22" Height="22" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"
                                      Fill="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                      Data="F0 M12,2 C8.1,2 5,5.1 5,9 C5,14.2 12,22 12,22 C12,22 19,14.2 19,9 C19,5.1 15.9,2 12,2 Z M12,11.5 C10.6,11.5 9.5,10.4 9.5,9 C9.5,7.6 10.6,6.5 12,6.5 C13.4,6.5 14.5,7.6 14.5,9 C14.5,10.4 13.4,11.5 12,11.5 Z"/>
                                <TextBlock x:Name="SehirBasligi" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"
                                           FontFamily="{StaticResource BaslikYazisi}"/>
                            </StackPanel>
                            <TextBlock x:Name="TarihYazisi" FontSize="17" TextWrapping="Wrap" Opacity="0.92" Margin="32,2,0,0"/>
                            <!-- Takvim sekmesinde başka bir gün seçiliyse: bu sekmenin hep bugünü gösterdiğini söyler. -->
                            <Border x:Name="VakitlerUyari" Visibility="Collapsed" CornerRadius="8" Padding="12,5" Margin="32,6,0,0"
                                    HorizontalAlignment="Left" Background="{DynamicResource AccentFillColorDefaultBrush}">
                                <TextBlock x:Name="VakitlerUyariMetni" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="SaatYazisi" Grid.Column="1" FontSize="36" FontWeight="Normal"
                                   FontFamily="{StaticResource BaslikYazisi}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Geri sayım kartı: süs katmanı (renk, parlama, ilerleme çubuğu) -->
                    <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,12" CornerRadius="16" IsHitTestVisible="False"
                            Background="{DynamicResource AccentFillColorDefaultBrush}">
                        <Grid>
                            <Border CornerRadius="16" IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Source={x:Static SystemParameters.HighContrast}}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#38FFFFFF" Offset="0"/>
                                        <GradientStop Color="#00FFFFFF" Offset="0.55"/>
                                        <GradientStop Color="#2A000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Grid Height="6" Margin="24,0,24,16" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                <Border CornerRadius="3" Background="#44FFFFFF"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="IlerlemeDolu" Width="0.001*"/>
                                        <ColumnDefinition x:Name="IlerlemeBos" Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border CornerRadius="3" Background="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                    <!-- Kalan süre metni kartın üstünde, ızgaranın doğrudan çocuğu: Tab sırasına bu sayede girer. -->
                    <TextBox x:Name="KalanSure" Grid.Row="1" Grid.ColumnSpan="3" Style="{StaticResource KartMetni}" TabIndex="2"
                             Margin="22,14,22,42" AutomationProperties.Name="Sıradaki vakte kalan süre"/>

                    <ListBox x:Name="AnaListe" Grid.Row="2" Grid.ColumnSpan="3" TabIndex="0" BorderThickness="0" Background="Transparent"
                             AutomationProperties.Name="Ana vakitler" ContextMenuOpening="VakitListesi_ContextMenuOpening"
                             ItemTemplate="{StaticResource VakitSablonu}"
                             ItemContainerStyle="{StaticResource KartOgesi}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewKeyDown="Liste_PreviewKeyDown">
                        <ListBox.ContextMenu>
                            <ContextMenu FontSize="{DynamicResource MenuYaziBoyutu}">
                                <MenuItem Tag="TekBildirim" Header="Bu vakti bir _kez bildir" Click="TekBildirim_Click"/>
                                <MenuItem Header="Vakti _panoya kopyala" InputGestureText="Ctrl+C" Click="KopyalaAna_Click"/>
                                <MenuItem Header="Ana vakitleri _paylaş…" Click="PaylasAna_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>

                </Grid>
                </ScrollViewer>
            </TabItem>
            <TabItem x:Name="TakvimSekme" Header="Takvim" FontSize="16" Padding="14,9">
                <!-- Sayfa küçük pencerede dikey kaydırılır. Tüm odaklanabilir kontroller aynı ızgaranın doğrudan çocuğudur;
                     klavye (Tab) sırası TabIndex ile belirlenir:
                     Günün Tarihi, Günün Sözü, Arka Yaprak, Tarih ve Günün Bilgileri, Takvimi göster, Önceki gün, Bugün, Sonraki gün.
                     Ekrandaki yerleşim: en üstte tarih ve günün bilgileri, altında düğmeler. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <Grid Margin="16,14,16,8" MaxWidth="820">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.ColumnSpan="5" Content="Tarih ve Günün Bilgileri" Target="{Binding ElementName=TarihKutusu}"
                           Style="{StaticResource BolumEtiketi}"/>
                    <TextBlock Grid.Row="0" Grid.ColumnSpan="5" Style="{StaticResource KisayolIpucu}" Text="Alt+B"/>
                    <yerel:KisayolluTextBox x:Name="TarihKutusu" ContextMenu="{StaticResource OkunurMetinMenusu}" Style="{StaticResource OkunurAlan}" Grid.Row="1" Grid.ColumnSpan="5" Margin="0,0,0,10" TabIndex="3"
                             AutomationProperties.Name="Tarih ve Günün Bilgileri" AutomationProperties.AccessKey="Alt+B" IsReadOnly="True"
                             IsReadOnlyCaretVisible="True" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" MinHeight="64" MaxHeight="300"
                             FontSize="17" Padding="12,10"/>

                    <Label Grid.Row="2" Grid.ColumnSpan="5" Content="Günün Vakitleri" Target="{Binding ElementName=GunVakitleri}"
                           Style="{StaticResource BolumEtiketi}"/>
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="5" Style="{StaticResource KisayolIpucu}" Text="Alt+V"/>
                    <yerel:KisayolluListBox x:Name="GunVakitleri" Style="{DynamicResource {x:Type ListBox}}" Grid.Row="3" Grid.ColumnSpan="5"
                             Margin="0,0,0,10" TabIndex="4" BorderThickness="0" Background="Transparent"
                             AutomationProperties.Name="Günün Vakitleri" AutomationProperties.AccessKey="Alt+V"
                             ItemTemplate="{StaticResource GunSablonu}"
                             ItemContainerStyle="{StaticResource MetinOgesi}"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewKeyDown="Liste_PreviewKeyDown">
                        <ListBox.ContextMenu>
                            <ContextMenu FontSize="{DynamicResource MenuYaziBoyutu}">
                                <MenuItem Header="Vakitleri _panoya kopyala" InputGestureText="Ctrl+C" Click="KopyalaGunVakitleri_Click"/>
                                <MenuItem Header="Günün vakitlerini _paylaş…" Click="PaylasGunVakitleri_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </yerel:KisayolluListBox>

                    <!-- Gün düğmeleri: büyük yazı boyutunda sığmayan düğmeler alt satıra geçer (WrapPanel), yazı kesilmez. -->
                    <WrapPanel Grid.Row="4" Grid.ColumnSpan="5" KeyboardNavigation.TabIndex="5" KeyboardNavigation.TabNavigation="Local" Margin="0,0,0,6">
                        <Button x:Name="TakvimGosterDugmesi" Content="Takvimi göster"
                                Margin="0,0,8,6" Padding="14,6" TabIndex="0" Click="TakvimiGoster_Click"/>
                        <yerel:GecersizOlabilenDugme x:Name="OncekiGunDugmesi" Style="{DynamicResource DefaultButtonStyle}"
                                Content="Önceki gün" Margin="0,0,8,6" Padding="14,6" TabIndex="1" Click="OncekiGun_Click"/>
                        <yerel:GecersizOlabilenDugme x:Name="BugunDugmesi" Style="{DynamicResource DefaultButtonStyle}"
                                Content="Bugün" Margin="0,0,8,6" Padding="14,6" TabIndex="2" Click="BugunTarihi_Click"/>
                        <yerel:GecersizOlabilenDugme x:Name="SonrakiGunDugmesi" Style="{DynamicResource DefaultButtonStyle}"
                                Content="Sonraki gün" Margin="0,0,8,6" Padding="14,6" TabIndex="3" Click="SonrakiGun_Click"/>
                        <Button x:Name="MubarekDugmesi" Content="Mübarek gün ve geceler"
                                Margin="0,0,0,6" Padding="14,6" TabIndex="4" Click="MubarekGunler_Click" IsTabStop="False" AutomationProperties.AcceleratorKey="Ctrl+M"/>
                    </WrapPanel>

                    <!-- Takvim açılır penceresi: Takvimi göster düğmesiyle açılır, ok tuşlarıyla gün/hafta gezilir, Enter seçer, Esc kapatır. -->
                    <Popup x:Name="TakvimPopup" PlacementTarget="{Binding ElementName=Sekmeler}"
                           Placement="Center" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border x:Name="TakvimPopupKok" Margin="8" Padding="12" CornerRadius="10" BorderThickness="1"
                                KeyboardNavigation.TabNavigation="Cycle"
                                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                PreviewKeyDown="TakvimPopup_PreviewKeyDown">
                            <StackPanel>
                                <Label Content="Tarih yazın (gün.ay.yıl)" Target="{Binding ElementName=TarihGirisKutusu}"
                                       Style="{StaticResource BolumEtiketi}"/>
                                <TextBox x:Name="TarihGirisKutusu" AutomationProperties.Name="Tarih yazın, gün ay yıl, örnek 23.10.2026"
                                         MaxLength="30" FontSize="17" Padding="10,8" Margin="0,0,0,6"
                                         TextChanged="TarihGirisKutusu_TextChanged"
                                         PreviewKeyDown="TarihGirisKutusu_PreviewKeyDown"/>
                                <TextBlock x:Name="TarihHatasi" Visibility="Collapsed" TextWrapping="Wrap" MaxWidth="260"
                                           Margin="2,0,0,8" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                           AutomationProperties.LiveSetting="Assertive"/>
                                <Calendar x:Name="TakvimKontrolu" AutomationProperties.Name="Takvim" SelectionMode="SingleDate"
                                          Loaded="TakvimKontrolu_Loaded"
                                          DisplayDateChanged="TakvimKontrolu_DisplayDateChanged"
                                          DisplayModeChanged="TakvimKontrolu_DisplayModeChanged"
                                          PreviewKeyDown="TakvimKontrolu_PreviewKeyDown"
                                          PreviewMouseLeftButtonUp="TakvimKontrolu_PreviewMouseLeftButtonUp"/>
                                <TextBlock x:Name="TakvimBilgisi" Margin="4,6,0,0" FontSize="15" FontWeight="SemiBold"
                                           TextWrapping="Wrap" MaxWidth="260"
                                           AutomationProperties.LiveSetting="Polite"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="TakvimTamamDugmesi" Content="Tamam" Padding="22,7" Click="TakvimTamam_Click"
                                            Style="{DynamicResource AccentButtonStyle}"/>
                                    <Button x:Name="TakvimVazgecDugmesi" Content="Vazgeç" Padding="22,7" Margin="8,0,0,0"
                                            Click="TakvimVazgec_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Label Grid.Row="5" Grid.ColumnSpan="5" Content="Günün Tarihi" Target="{Binding ElementName=OlayKutusu}"
                           Style="{StaticResource BolumEtiketi}"/>
                    <TextBlock Grid.Row="5" Grid.ColumnSpan="5" Style="{StaticResource KisayolIpucu}" Text="Alt+T"/>
                    <yerel:KisayolluTextBox x:Name="OlayKutusu" ContextMenu="{StaticResource OkunurMetinMenusu}" Style="{StaticResource OkunurAlan}" Grid.Row="6" Grid.ColumnSpan="5" Margin="0,0,0,12" TabIndex="0"
                             AutomationProperties.Name="Günün Tarihi" AutomationProperties.AccessKey="Alt+T" IsReadOnly="True"
                             IsReadOnlyCaretVisible="True" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" MinHeight="56" MaxHeight="110"
                             FontSize="17" Padding="12,10"/>

                    <Label Grid.Row="7" Grid.ColumnSpan="5" Content="Günün Sözü" Target="{Binding ElementName=SozKutusu}"
                           Style="{StaticResource BolumEtiketi}"/>
                    <TextBlock Grid.Row="7" Grid.ColumnSpan="5" Style="{StaticResource KisayolIpucu}" Text="Alt+S"/>
                    <yerel:KisayolluTextBox x:Name="SozKutusu" ContextMenu="{StaticResource OkunurMetinMenusu}" Style="{StaticResource OkunurAlan}" Grid.Row="8" Grid.ColumnSpan="5" Margin="0,0,0,12" TabIndex="1"
                             AutomationProperties.Name="Günün Sözü" AutomationProperties.AccessKey="Alt+S" IsReadOnly="True"
                             IsReadOnlyCaretVisible="True" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" MinHeight="56" MaxHeight="110"
                             FontSize="17" Padding="12,10"/>

                    <Label Grid.Row="9" Grid.ColumnSpan="5" Content="Arka Yaprak" Target="{Binding ElementName=ArkaYaprakKutusu}"
                           Style="{StaticResource BolumEtiketi}"/>
                    <TextBlock Grid.Row="9" Grid.ColumnSpan="5" Style="{StaticResource KisayolIpucu}" Text="Alt+A"/>
                    <yerel:KisayolluTextBox x:Name="ArkaYaprakKutusu" ContextMenu="{StaticResource OkunurMetinMenusu}" Style="{StaticResource OkunurAlan}" Grid.Row="10" Grid.ColumnSpan="5" TabIndex="2" Height="300"
                             AutomationProperties.Name="Arka Yaprak" AutomationProperties.AccessKey="Alt+A" IsReadOnly="True"
                             IsReadOnlyCaretVisible="True" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" FontSize="17" Padding="12,10"/>
                </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="DigerSekme" Header="Diğer Vakitler" FontSize="16" Padding="14,9">
                <Grid Margin="16,14,16,8" MaxWidth="760">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Başlık: Vakitler sekmesiyle aynı yer ve tarih satırları (aynı metinlere bağlı; süs amaçlı simge ekran okuyucuya görünmez). -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="22" Height="22" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center"
                                  Fill="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                  Data="F0 M12,2 C8.1,2 5,5.1 5,9 C5,14.2 12,22 12,22 C12,22 19,14.2 19,9 C19,5.1 15.9,2 12,2 Z M12,11.5 C10.6,11.5 9.5,10.4 9.5,9 C9.5,7.6 10.6,6.5 12,6.5 C13.4,6.5 14.5,7.6 14.5,9 C14.5,10.4 13.4,11.5 12,11.5 Z"/>
                            <TextBlock Text="{Binding Text, ElementName=SehirBasligi}" FontSize="28" FontWeight="SemiBold" TextWrapping="Wrap"
                                       FontFamily="{StaticResource BaslikYazisi}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Text, ElementName=TarihYazisi}" FontSize="17" TextWrapping="Wrap" Opacity="0.92" Margin="32,2,0,0"/>
                    </StackPanel>

                    <Border x:Name="DigerUyari" Grid.Row="1" Visibility="Collapsed" CornerRadius="8" Padding="12,5" Margin="0,0,0,10"
                            HorizontalAlignment="Left" Background="{DynamicResource AccentFillColorDefaultBrush}">
                        <TextBlock x:Name="DigerUyariMetni" TextWrapping="Wrap" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                    </Border>
                    <ListBox x:Name="DigerListe" Grid.Row="2" BorderThickness="0" Background="Transparent" Padding="0,0,10,0"
                             AutomationProperties.Name="Diğer vakitler" ContextMenuOpening="VakitListesi_ContextMenuOpening"
                             ItemTemplate="{StaticResource VakitSablonu}"
                             ItemContainerStyle="{StaticResource KartOgesi}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewKeyDown="Liste_PreviewKeyDown">
                        <ListBox.ContextMenu>
                            <ContextMenu FontSize="{DynamicResource MenuYaziBoyutu}">
                                <MenuItem Tag="TekBildirim" Header="Bu vakti bir _kez bildir" Click="TekBildirim_Click"/>
                                <MenuItem Header="Vakti _panoya kopyala" InputGestureText="Ctrl+C" Click="KopyalaDiger_Click"/>
                                <MenuItem Header="Diğer vakitleri _paylaş…" Click="PaylasDiger_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                </Grid>
            </TabItem>

            <TabItem x:Name="CizelgeSekme" Header="Çizelgeler" FontSize="16" Padding="14,9">
                <!-- Haftalık, Aylık ve İmsakiye tek sekmede; üstteki seçenekler hangisinin görüneceğini belirler.
                     Tab sırası: çizelge türü, seçili çizelgenin kendi öğeleri. Ctrl+4/5/6 doğrudan ilgili çizelgeyi açar. -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" MaxWidth="800" Margin="16,12,16,0">
                        <StackPanel Orientation="Horizontal" AutomationProperties.Name="Çizelge türü">
                            <RadioButton x:Name="HaftaSecenegi" GroupName="CizelgeTuru" Content="Haftalık" IsChecked="True"
                                         Style="{StaticResource CizelgeSecenegi}" Checked="CizelgeSecenegi_Checked"/>
                            <RadioButton x:Name="AylikSecenegi" GroupName="CizelgeTuru" Content="Aylık" Margin="8,0,0,0"
                                         Style="{StaticResource CizelgeSecenegi}" Checked="CizelgeSecenegi_Checked"/>
                            <RadioButton x:Name="ImsakiyeSecenegi" GroupName="CizelgeTuru" Content="İmsakiye" Margin="8,0,0,0"
                                         Style="{StaticResource CizelgeSecenegi}" Checked="CizelgeSecenegi_Checked"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1">            <Grid x:Name="HaftaIcerik" Visibility="Visible">
                <Grid Margin="16,14,16,8" MaxWidth="760">
                    <ListBox x:Name="HaftaListesi" BorderThickness="0" Background="Transparent" Padding="0,0,10,0"
                             AutomationProperties.Name="Haftalık vakitler"
                             ItemTemplate="{StaticResource GunSablonu}"
                             ItemContainerStyle="{StaticResource MetinOgesi}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewKeyDown="Liste_PreviewKeyDown">
                        <ListBox.ContextMenu>
                            <ContextMenu FontSize="{DynamicResource MenuYaziBoyutu}">
                                <MenuItem Header="Günü _panoya kopyala" InputGestureText="Ctrl+C" Click="KopyalaHafta_Click"/>
                                <MenuItem Header="Haftayı _paylaş…" Click="PaylasHafta_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                    <TextBlock x:Name="HaftaBilgisi" Text="Haftalık vakitler henüz yüklenmedi." Visibility="Collapsed"
                               FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Grid>

            <Grid x:Name="AylikIcerik" Visibility="Collapsed">
                <!-- Tab sırası yazıldığı gibidir: ay bilgisi, gün listesi, ay düğmeleri, yazdır ve PDF. -->
                <Grid Margin="16,14,16,8" MaxWidth="800">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" CornerRadius="10" Padding="12,8" Margin="0,0,0,10"
                            Background="{DynamicResource AccentFillColorDefaultBrush}">
                        <TextBox x:Name="AylikBilgisi" Style="{StaticResource KartMetni}" FontSize="19"
                                 AutomationProperties.Name="Aylık çizelge bilgisi"/>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,0,17,4">
                        <Grid MinWidth="540" Margin="10,0,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Gün" FontSize="13" FontWeight="SemiBold" Opacity="0.8"/>
                            <TextBlock Grid.Column="1" Text="Tarih" FontSize="13" FontWeight="SemiBold" Opacity="0.8"/>
                            <TextBlock Grid.Column="2" Text="Günler" FontSize="13" FontWeight="SemiBold" Opacity="0.8"/>
                            <UniformGrid Grid.Column="3" Rows="1">
                                <TextBlock Text="İmsak" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Opacity="0.8"/>
                                <TextBlock Text="Sabah" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Opacity="0.8"/>
                                <TextBlock Text="Güneş" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Opacity="0.8"/>
                                <TextBlock Text="Öğle" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Opacity="0.8"/>
                                <TextBlock Text="İkindi" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Opacity="0.8"/>
                                <TextBlock Text="Akşam" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Opacity="0.8"/>
                                <TextBlock Text="Yatsı" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Opacity="0.8"/>
                            </UniformGrid>
                        </Grid>
                    </Grid>

                    <ListBox x:Name="AylikListesi" Grid.Row="2" BorderThickness="0" Background="Transparent" Padding="0,0,10,0"
                             AutomationProperties.Name="Aylık vakitler"
                             ItemTemplate="{StaticResource AylikSablonu}"
                             ItemContainerStyle="{StaticResource ImsakiyeOgesi}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Visible"
                             PreviewKeyDown="Liste_PreviewKeyDown">
                        <ListBox.ContextMenu>
                            <ContextMenu FontSize="{DynamicResource MenuYaziBoyutu}">
                                <MenuItem Header="Günü _panoya kopyala" InputGestureText="Ctrl+C" Click="KopyalaAylik_Click"/>
                                <MenuItem Header="Ayı _paylaş…" Click="PaylasAylik_Click"/>
                                <MenuItem Header="Ayı _yazdır" InputGestureText="Ctrl+P" Click="AylikYazdir_Click"/>
                                <MenuItem Header="Ayı P_DF olarak kaydet" InputGestureText="Ctrl+Shift+P" Click="AylikPdf_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>

                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button x:Name="OncekiAyDugmesi" Content="Önceki ay" Padding="16,8" Click="OncekiAy_Click"/>
                            <yerel:GecersizOlabilenDugme x:Name="BuAyDugmesi" Style="{DynamicResource DefaultButtonStyle}"
                                    Content="Bu ay" Padding="16,8" Margin="8,0,0,0" Click="BuAy_Click"/>
                            <Button x:Name="SonrakiAyDugmesi" Content="Sonraki ay" Padding="16,8" Margin="8,0,0,0" Click="SonrakiAy_Click"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="AylikYazdirDugmesi" Content="Yazdır" Padding="20,8" Click="AylikYazdir_Click"
                                    AutomationProperties.Name="Ayı yazdır" AutomationProperties.AcceleratorKey="Ctrl+P"/>
                            <Button x:Name="AylikPdfDugmesi" Content="PDF olarak kaydet" Padding="16,8" Margin="8,0,0,0" Click="AylikPdf_Click"
                                    AutomationProperties.Name="Ayı PDF olarak kaydet" AutomationProperties.AcceleratorKey="Ctrl+Shift+P"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <Grid x:Name="ImsakiyeIcerik" Visibility="Collapsed">
                <!-- Tab sırası yazıldığı gibidir: imsakiye bilgisi, gün listesi, notlar. -->
                <Grid Margin="16,14,16,8" MaxWidth="800">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="70"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" CornerRadius="10" Padding="12,8" Margin="0,0,0,10"
                            Background="{DynamicResource AccentFillColorDefaultBrush}">
                        <TextBox x:Name="ImsakiyeBilgisi" Style="{StaticResource KartMetni}" FontSize="19"
                                 AutomationProperties.Name="İmsakiye bilgisi"/>
                    </Border>

                    <!-- Sütun başlıkları (görsel; ekran okuyucu her satırı zaten tam cümleyle okur) -->
                    <Grid x:Name="ImsakiyeBasligi" Grid.Row="1" Margin="0,0,17,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="84"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Margin="10,0,10,0" MinWidth="540" Grid.ColumnSpan="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="96"/>
                                <ColumnDefinition Width="84"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Gün" FontSize="13" FontWeight="SemiBold" Opacity="0.8"/>
                            <TextBlock Grid.Column="1" Text="Tarih" FontSize="13" FontWeight="SemiBold" Opacity="0.8"/>
                            <TextBlock Grid.Column="2" Text="Günler" FontSize="13" FontWeight="SemiBold" Opacity="0.8"/>
                            <UniformGrid Grid.Column="3" Rows="1">
                                <TextBlock Text="İmsak" HorizontalAlignment="Center" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Sabah" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Opacity="0.8"/>
                                <TextBlock Text="Güneş" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Opacity="0.8"/>
                                <TextBlock Text="İşrak" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Opacity="0.8"/>
                                <TextBlock Text="Öğle" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Opacity="0.8"/>
                                <TextBlock Text="İkindi" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Opacity="0.8"/>
                                <TextBlock Text="Akşam" HorizontalAlignment="Center" FontSize="13" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Yatsı" HorizontalAlignment="Center" FontSize="13" FontWeight="SemiBold" Opacity="0.8"/>
                            </UniformGrid>
                        </Grid>
                    </Grid>

                    <ListBox x:Name="ImsakiyeListesi" Grid.Row="2" BorderThickness="0" Background="Transparent" Padding="0,0,10,0"
                             AutomationProperties.Name="İmsakiye günleri"
                             ItemTemplate="{StaticResource ImsakiyeSablonu}"
                             ItemContainerStyle="{StaticResource ImsakiyeOgesi}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Visible"
                             PreviewKeyDown="Liste_PreviewKeyDown">
                        <ListBox.ContextMenu>
                            <ContextMenu FontSize="{DynamicResource MenuYaziBoyutu}">
                                <MenuItem Header="Günü _panoya kopyala" InputGestureText="Ctrl+C" Click="KopyalaImsakiye_Click"/>
                                <MenuItem Header="İmsakiyeyi _paylaş…" Click="PaylasImsakiye_Click"/>
                                <MenuItem Header="İmsakiyeyi _yazdır" InputGestureText="Ctrl+P" Click="ImsakiyeYazdir_Click"/>
                                <MenuItem Header="İmsakiyeyi P_DF olarak kaydet" InputGestureText="Ctrl+Shift+P" Click="ImsakiyePdf_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>

                    <TextBox x:Name="ImsakiyeNotlari" Grid.Row="3" Margin="0,8,0,0" MaxHeight="68" ContextMenu="{StaticResource OkunurMetinMenusu}"
                             Style="{StaticResource OkunurAlan}" AutomationProperties.Name="İmsakiye notları"
                             IsReadOnly="True" IsReadOnlyCaretVisible="True" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" FontSize="17" Padding="12,10"/>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button x:Name="ImsakiyeYazdirDugmesi" Content="Yazdır" Padding="26,8" Click="ImsakiyeYazdir_Click"
                                AutomationProperties.Name="İmsakiyeyi yazdır" AutomationProperties.AcceleratorKey="Ctrl+P"/>
                        <Button x:Name="ImsakiyePdfDugmesi" Content="PDF olarak kaydet" Padding="22,8" Margin="8,0,0,0" Click="ImsakiyePdf_Click"
                                AutomationProperties.Name="İmsakiyeyi PDF olarak kaydet" AutomationProperties.AcceleratorKey="Ctrl+Shift+P"/>
                    </StackPanel>
                </Grid>
            </Grid>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
    </DockPanel>
</Window>
