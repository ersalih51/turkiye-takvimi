<Window x:Class="TurkiyeTakvimi.Arayuz.BelgePenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Belge" Width="760" Height="780" MinWidth="460" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="16"
        FontFamily="Segoe UI Variable Text, Segoe UI" Icon="Varliklar/uygulama.ico">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Başlık seviyeli bir belge: ekran okuyucuda gezinti kipinde H ve 1-6 tuşlarıyla başlıklar arasında dolaşılır.
         Tab sırası: belge, Kapat. Esc kapatır. -->
    <Grid Margin="24,18,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="12" Padding="18,14" Margin="0,0,0,12"
                Background="{DynamicResource AccentFillColorDefaultBrush}">
            <StackPanel>
                <TextBlock x:Name="Baslik" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"
                           FontFamily="{StaticResource BaslikYazisi}"
                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                <TextBlock x:Name="AltBaslik" FontSize="17" Margin="0,2,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" CornerRadius="10" BorderThickness="1" Padding="1" Margin="0,0,0,12"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <WebBrowser x:Name="Tarayici" LoadCompleted="Tarayici_LoadCompleted" Navigating="Tarayici_Navigating"/>
        </Border>

        <Button Grid.Row="2" HorizontalAlignment="Right" Content="Kapat" Padding="28,8"
                Style="{DynamicResource AccentButtonStyle}" IsCancel="True" Click="Kapat_Click"/>
    </Grid>
</Window>
