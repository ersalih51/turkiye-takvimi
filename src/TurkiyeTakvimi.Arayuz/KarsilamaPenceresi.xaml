<Window x:Class="TurkiyeTakvimi.Arayuz.KarsilamaPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hoş geldiniz" Width="640" SizeToContent="Height" MinWidth="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="16"
        FontFamily="Segoe UI Variable Text, Segoe UI" Icon="Varliklar/uygulama.ico">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Tab sırası: bilgi metni, Başla. Enter ve Esc pencereyi kapatır. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
        <StackPanel x:Name="Kok" Margin="24,20,24,18">

            <Border CornerRadius="12" Padding="20,18" Margin="0,0,0,14"
                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Image x:Name="Simge" Width="72" Height="72" Margin="0,0,18,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Hoş geldiniz" FontSize="32" FontWeight="SemiBold" FontFamily="{StaticResource BaslikYazisi}"
                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                        <TextBlock Text="Türkiye Takvimi'ne" FontSize="18" Margin="0,2,0,0"
                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TextBox x:Name="Metin" Style="{StaticResource OkunurYazi}" Margin="0,0,0,14" Height="300" FontSize="17"
                     AutomationProperties.Name="Hoş geldiniz"/>

            <Button x:Name="BaslaDugmesi" HorizontalAlignment="Right" Padding="32,9" IsDefault="True" IsCancel="True"
                    Style="{DynamicResource AccentButtonStyle}" Click="Basla_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>
