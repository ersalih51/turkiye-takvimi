<Window x:Class="TurkiyeTakvimi.Arayuz.SehirSecimPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yer seç" Width="600" Height="680" MinWidth="440" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="16"
        FontFamily="Segoe UI Variable Text, Segoe UI" Icon="Varliklar/uygulama.ico">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="SonucSablonu">
                <Border Style="{StaticResource BilgiKarti}" Padding="16,10">
                    <StackPanel>
                        <TextBlock Text="{Binding Ad}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Ulke}" FontSize="15" Opacity="0.9" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Tüm odaklanabilir kontroller aynı ızgaranın çocuğudur; Tab sırası aşağıdan yukarı yazıldığı gibidir:
         yer adı kutusu, Ara, Konumumu tahmin et, Sonuçlar, Seç, Vazgeç. -->
    <Grid x:Name="Kok" Margin="24,20,24,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2" CornerRadius="12" Padding="18,14" Margin="0,0,0,14"
                Background="{DynamicResource AccentFillColorDefaultBrush}">
            <StackPanel>
                <TextBlock Text="Yer seç" FontSize="26" FontWeight="SemiBold" FontFamily="{StaticResource BaslikYazisi}"
                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                <TextBlock TextWrapping="Wrap" FontSize="17" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                           Text="Vakitleri görmek istediğiniz yeri yazın: şehir, ilçe, kasaba ya da köy olabilir."/>
            </StackPanel>
        </Border>

        <Label Grid.Row="2" Grid.ColumnSpan="2" Content="Yer adı" Target="{Binding ElementName=AramaKutusu}"
               Style="{StaticResource BolumEtiketi}"/>
        <TextBox x:Name="AramaKutusu" Grid.Row="3" Grid.Column="0" Padding="10,8" FontSize="18" MaxLength="40"
                 AutomationProperties.Name="Yer adı, şehir ilçe kasaba veya köy"
                 PreviewKeyDown="AramaKutusu_PreviewKeyDown"/>
        <Button x:Name="AraDugmesi" Grid.Row="3" Grid.Column="1" Content="Ara" Margin="10,0,0,0" Padding="26,9"
                Style="{DynamicResource AccentButtonStyle}" Click="Ara_Click"/>

        <Button x:Name="KonumDugmesi" Grid.Row="4" Grid.ColumnSpan="2" Content="Konumumu internet adresimden tahmin et"
                HorizontalAlignment="Left" Margin="0,10,0,0" Padding="16,8" Click="Konum_Click"/>

        <TextBlock x:Name="Durum" Grid.Row="5" Grid.ColumnSpan="2" Margin="2,12,0,10" TextWrapping="Wrap" FontSize="16"
                   FontWeight="SemiBold" MinHeight="24" AutomationProperties.LiveSetting="Polite"/>

        <ListBox x:Name="Sonuclar" Grid.Row="6" Grid.ColumnSpan="2" BorderThickness="0" Background="Transparent" Padding="0,0,10,0"
                 AutomationProperties.Name="Sonuçlar"
                 ItemTemplate="{StaticResource SonucSablonu}"
                 ItemContainerStyle="{StaticResource KartOgesi}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 PreviewKeyDown="Sonuclar_PreviewKeyDown"
                 MouseDoubleClick="Sonuclar_MouseDoubleClick"/>

        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="SecDugmesi" Content="Seç" Padding="30,9" Style="{DynamicResource AccentButtonStyle}"
                    Click="Sec_Click"/>
            <Button x:Name="VazgecDugmesi" Content="Vazgeç" Padding="26,9" Margin="10,0,0,0" IsCancel="True"
                    Click="Vazgec_Click"/>
        </StackPanel>
    </Grid>
</Window>
