<Window x:Class="TurkiyeTakvimi.Arayuz.GuncellemePenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Güncellemeleri denetle" Width="640" SizeToContent="Height" MinWidth="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="16"
        FontFamily="Segoe UI Variable Text, Segoe UI" Icon="Varliklar/uygulama.ico">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Tab sırası: bilgi metni, İndir ve kur, Sürüm sayfasını aç, Kapat. Düğme satırı kaydırma alanının dışındadır. -->
    <Grid x:Name="Kok">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
            <StackPanel Margin="24,20,24,6">
                <Border CornerRadius="12" Padding="18,14" Margin="0,0,0,12" Background="{DynamicResource AccentFillColorDefaultBrush}">
                    <StackPanel>
                        <TextBlock Text="Güncellemeleri denetle" FontSize="26" FontWeight="SemiBold" FontFamily="{StaticResource BaslikYazisi}"
                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                        <TextBlock x:Name="AltBaslik" FontSize="17" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </Border>

                <TextBox x:Name="Metin" Style="{StaticResource OkunurYazi}" Height="240" FontSize="17"
                         AutomationProperties.Name="Güncelleme bilgisi"/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="24,6,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                <Button x:Name="IndirDugmesi" Content="İndir ve kur" Padding="22,9" Margin="0,0,8,6" Visibility="Collapsed"
                        Style="{DynamicResource AccentButtonStyle}" Click="Indir_Click"/>
                <Button x:Name="SayfaDugmesi" Content="Sürüm sayfasını aç" Padding="18,9" Margin="0,0,8,6" Visibility="Collapsed"
                        Click="Sayfa_Click"/>
            </WrapPanel>
            <Button x:Name="KapatDugmesi" Grid.Column="1" Content="Kapat" Padding="28,9" VerticalAlignment="Top"
                    IsCancel="True" Style="{DynamicResource AccentButtonStyle}" Click="Kapat_Click"/>
        </Grid>
    </Grid>
</Window>
