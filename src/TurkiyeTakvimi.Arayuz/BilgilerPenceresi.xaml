<Window x:Class="TurkiyeTakvimi.Arayuz.BilgilerPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:yerel="clr-namespace:TurkiyeTakvimi.Arayuz"
        Title="Bilgiler" Width="760" Height="780" MinWidth="460" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="16"
        FontFamily="Segoe UI Variable Text, Segoe UI" Icon="Varliklar/uygulama.ico"
        PreviewKeyDown="Pencere_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="BilgiOgesi" TargetType="ListBoxItem" BasedOn="{StaticResource KartOgesi}">
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="AutomationProperties.PositionInSet" Value="0"/>
                <Setter Property="AutomationProperties.SizeOfSet" Value="0"/>
            </Style>

            <!-- Başlık satırı: bir kart; yazı değil de sitede açılan başlıklar küçük bir etiket taşır. -->
            <DataTemplate x:Key="BaslikSablonu">
                <Border CornerRadius="10" BorderThickness="1" Padding="16,10"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Baslik}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <Border Grid.Column="1" CornerRadius="10" Padding="10,2" Margin="12,0,0,0" VerticalAlignment="Center"
                                BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Visibility="{Binding SiteEtiketi}">
                            <TextBlock Text="sitede açılır" FontSize="13" FontWeight="SemiBold"/>
                        </Border>
                    </Grid>
                </Border>
            </DataTemplate>

        </ResourceDictionary>
    </Window.Resources>

    <!-- Sayfa 1 (başlıklar): arama kutusu, başlık listesi, Kapat. Sayfa 2 (yazı): paragraf listesi, Başlıklara dön, Yazıyı kopyala, Sitede aç, Kapat. -->
    <Grid x:Name="Kok" Margin="24,18,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="12" Padding="18,14" Margin="0,0,0,12"
                Background="{DynamicResource AccentFillColorDefaultBrush}">
            <StackPanel>
                <TextBlock x:Name="Baslik" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"
                           FontFamily="{StaticResource BaslikYazisi}"
                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                <TextBlock x:Name="AltBaslik" FontSize="17" Margin="0,2,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Sayfa 1 -->
        <Grid x:Name="BasliklarSayfasi" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Başlıklarda ara" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,12,0"/>
                <TextBox x:Name="AramaKutusu" Grid.Column="1" Padding="8,6" AutomationProperties.Name="Başlıklarda ara"
                         TextChanged="AramaKutusu_TextChanged" PreviewKeyDown="AramaKutusu_PreviewKeyDown"/>
            </Grid>
            <ListBox x:Name="BasliklarListesi" Grid.Row="1" BorderThickness="0" Background="Transparent" Padding="0,0,10,0"
                     ItemTemplate="{StaticResource BaslikSablonu}"
                     ItemContainerStyle="{StaticResource BilgiOgesi}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     PreviewKeyDown="BasliklarListesi_PreviewKeyDown" MouseDoubleClick="BasliklarListesi_MouseDoubleClick"/>
        </Grid>

        <!-- Sayfa 2 -->
        <!-- Yazı: imleçli salt okunur metin; NVDA'nın "tümünü oku" (Insert+Aşağı ok) ve satır satır okuması çalışır. Paragraflar tek satır sonuyla ayrılır (boş satır yok). -->
        <TextBox x:Name="YaziKutusu" Grid.Row="1" Visibility="Collapsed" Style="{StaticResource OkunurYazi}"/>

        <TextBlock x:Name="Durum" Grid.Row="2" Margin="2,8,0,8" TextWrapping="Wrap" FontWeight="SemiBold" MinHeight="22"
                   AutomationProperties.LiveSetting="Polite"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="YaziDugmeleri" Orientation="Horizontal" Visibility="Collapsed">
                <Button x:Name="DonDugmesi" Content="Başlıklara dön" Padding="16,8" Click="Don_Click"/>
                <Button x:Name="KopyalaDugmesi" Content="Yazıyı kopyala" Padding="16,8" Margin="8,0,0,0" Click="YaziyiKopyala_Click"/>
                <Button x:Name="SiteDugmesi" Content="Sitede aç" Padding="16,8" Margin="8,0,0,0" Click="Site_Click"/>
            </StackPanel>
            <Button x:Name="KapatDugmesi" Grid.Column="2" Content="Kapat" Padding="28,8"
                    Style="{DynamicResource AccentButtonStyle}" Click="Kapat_Click"/>
        </Grid>
    </Grid>
</Window>
