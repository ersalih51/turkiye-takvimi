<Window x:Class="TurkiyeTakvimi.Arayuz.AyarlarPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:yerel="clr-namespace:TurkiyeTakvimi.Arayuz"
        Title="Ayarlar" Width="640" SizeToContent="Height" MinWidth="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="16"
        FontFamily="Segoe UI Variable Text, Segoe UI" Icon="Varliklar/uygulama.ico">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Tab sırası (Genel ayarlar): Seçili yer, Yeri değiştir, Tepside çalış, Windows ile başlat, Ramazan, Kısayol, Ezânî,
         İlk kurulum haline dön, Kapat. Çevrimdışı veri: Arka planda indir, Önbellek bilgisi, Temizle, Klasörü aç,
         Yıl seçimi, Yılı indir, İptal, Kapat. -->
    <Grid x:Name="Kok">
    <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
    <StackPanel Margin="24,16,24,6">
        <!-- Aynı pencere iki ayrı konuyu gösterir: Genel ayarlar (yer ve genel seçenekler) ya da Çevrimdışı veri; menüden hangisi seçildiyse yalnızca o görünür. -->
        <Border CornerRadius="12" Padding="18,14" Margin="0,0,0,12" Background="{DynamicResource AccentFillColorDefaultBrush}">
            <TextBlock x:Name="BaslikYazisi" Text="Genel ayarlar" FontSize="26" FontWeight="SemiBold" FontFamily="{StaticResource BaslikYazisi}"
                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
        </Border>

        <!-- Yer: bilgi solda, işlem düğmesi sağda -->
        <Border x:Name="YerKarti" Style="{StaticResource BilgiKarti}" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                    <Label Content="Seçili yer" Target="{Binding ElementName=SehirKutusu}" Style="{StaticResource BolumEtiketi}"/>
                    <TextBox x:Name="SehirKutusu" Style="{StaticResource OkunurYazi}" Padding="12,8" FontSize="17" TextBlock.LineHeight="24" VerticalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Seçili yer"/>
                </StackPanel>
                <Button x:Name="SehirDegistirDugmesi" Grid.Row="0" Grid.Column="1" Content="Yeri değiştir…"
                        VerticalAlignment="Bottom" Padding="18,8"
                        Style="{DynamicResource AccentButtonStyle}" Click="SehirDegistir_Click"/>
            </Grid>
        </Border>

        <Border x:Name="GenelKarti" Style="{StaticResource BilgiKarti}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Genel" FontSize="18" FontWeight="SemiBold" Margin="2,0,0,8"/>
                <CheckBox x:Name="TepsiKutusu" Margin="0,0,0,6" Checked="Tepsi_Click" Unchecked="Tepsi_Click"
                          Content="Pencere kapatılınca bildirim alanında çalışmaya devam et"/>
                <CheckBox x:Name="BaslatKutusu" Margin="0,0,0,6" Checked="Baslat_Click" Unchecked="Baslat_Click"
                          Content="Windows ile birlikte başlat"/>
                <CheckBox x:Name="RamazanKutusu" Margin="0,0,0,6" Checked="Ramazan_Click" Unchecked="Ramazan_Click"
                          Content="Ramazan'da iftar ve sahur bilgisini öne çıkar"/>
                <CheckBox x:Name="KisayolKutusu" Margin="0,0,0,6" Checked="Kisayol_Click" Unchecked="Kisayol_Click"
                          Content="Win+Alt+V ile, her yerden sıradaki vakti söylet"/>
                <CheckBox x:Name="EzaniKutusu" Margin="0,0,0,8" Checked="Ezani_Click" Unchecked="Ezani_Click"
                          Content="Diğer Vakitler'de Ezânî (alaturka) vakitleri de göster"/>
                <TextBlock TextWrapping="Wrap" Margin="2,0,0,0" FontSize="14" Opacity="0.85"
                           Text="Bildirimler için uygulamanın açık olması gerekir; ilk ikisini açık tutmanız önerilir."/>
            </StackPanel>
        </Border>

        <Border x:Name="CevrimdisiKarti" Style="{StaticResource BilgiKarti}" Margin="0,0,0,10">
            <StackPanel>
                <CheckBox x:Name="ArkaPlanKutusu" Margin="0,0,0,8" Checked="ArkaPlan_Click" Unchecked="ArkaPlan_Click"
                          Content="Yılın içeriğini arka planda indir"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="OnbellekBilgisi" Style="{StaticResource OkunurYazi}" Padding="12,8" FontSize="17" TextBlock.LineHeight="24" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center"
                             AutomationProperties.Name="Önbellek bilgisi"/>
                    <Button x:Name="TemizleDugmesi" Grid.Column="1" Content="Temizle" Margin="10,0,0,0" Padding="16,7"
                            Click="Temizle_Click" AutomationProperties.Name="Önbelleği temizle"/>
                    <Button x:Name="KlasorDugmesi" Grid.Column="2" Content="Klasörü aç" Margin="8,0,0,0" Padding="16,7"
                            Click="Klasor_Click" AutomationProperties.Name="Önbellek klasörünü aç"/>
                </Grid>

                <Label Content="Çevrimdışı için yıl indir" Target="{Binding ElementName=YilKutusu}" Style="{StaticResource BolumEtiketi}"/>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="YilKutusu" FontSize="17" AutomationProperties.Name="İndirilecek yıl"
                              SelectionChanged="YilKutusu_SelectionChanged"/>
                    <yerel:GecersizOlabilenDugme x:Name="YilIndirDugmesi" Grid.Column="1" Style="{DynamicResource DefaultButtonStyle}"
                            Content="Yılı indir" Margin="10,0,0,0" Padding="16,7" Click="YilIndir_Click"/>
                    <Button x:Name="YilIptalDugmesi" Grid.Column="2" Content="İptal" Margin="8,0,0,0" Padding="16,7"
                            IsEnabled="False" Click="YilIptal_Click"/>
                </Grid>
                <TextBlock x:Name="YilBilgisi" TextWrapping="Wrap" Margin="2,0,0,0" FontSize="14" Opacity="0.85"
                           Text="Seçilen yılın içeriğini ve seçili yerin vakitlerini indirir: yaklaşık 1,4 MB, birkaç dakika. İndirirken uygulamayı kullanabilirsiniz."/>
                <Grid x:Name="YilCubuguKabi" Height="6" Margin="2,10,2,0" Visibility="Collapsed" IsHitTestVisible="False">
                    <Border CornerRadius="3" Background="{DynamicResource CardStrokeColorDefaultBrush}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="YilDolu" Width="0.001*"/>
                            <ColumnDefinition x:Name="YilBos" Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="3" Background="{DynamicResource AccentFillColorDefaultBrush}"/>
                    </Grid>
                </Grid>
            </StackPanel>
        </Border>

    </StackPanel>
    </ScrollViewer>
        <Grid Grid.Row="1" Margin="24,6,24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="Durum" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,0,12,0"
                       AutomationProperties.LiveSetting="Polite"/>
            <Button x:Name="SifirlaDugmesi" Grid.Column="1" Content="İlk kurulum haline dön…" Padding="16,9" Margin="0,0,8,0"
                    Click="Sifirla_Click"/>
            <Button x:Name="KapatDugmesi" Grid.Column="2" Content="Kapat" Padding="28,9"
                    IsCancel="True" Style="{DynamicResource AccentButtonStyle}" Click="Kapat_Click"/>
        </Grid>
    </Grid>
</Window>
