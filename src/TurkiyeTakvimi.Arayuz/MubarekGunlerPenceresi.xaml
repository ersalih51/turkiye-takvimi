<Window x:Class="TurkiyeTakvimi.Arayuz.MubarekGunlerPenceresi"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:yerel="clr-namespace:TurkiyeTakvimi.Arayuz"
        Title="Mübarek Gün ve Geceler" Width="660" Height="760" MinWidth="440" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontSize="16"
        FontFamily="Segoe UI Variable Text, Segoe UI" Icon="Varliklar/uygulama.ico">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Stiller.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="MubarekOgesi" TargetType="ListBoxItem" BasedOn="{StaticResource KartOgesi}">
                <Setter Property="Margin" Value="0,0,0,6"/>
                <Setter Property="AutomationProperties.PositionInSet" Value="0"/>
                <Setter Property="AutomationProperties.SizeOfSet" Value="0"/>
            </Style>

            <!-- Satır: ad ve tarih solda; tür etiketi ve "Yarın / 12 gün sonra" durumu sağda. Sıradaki satır vurgulu, geçmişler soluk. -->
            <DataTemplate x:Key="MubarekSablonu">
                <Grid>
                    <Border CornerRadius="10" BorderThickness="1"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"/>
                    <Border x:Name="Vurgu" CornerRadius="10" Visibility="Collapsed" Opacity="0.18"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"/>
                    <Border x:Name="Serit" Visibility="Collapsed" Width="5" HorizontalAlignment="Left" CornerRadius="3"
                            Margin="7,12,0,12" Background="{DynamicResource AccentFillColorDefaultBrush}"/>
                    <Grid Margin="24,10,18,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="Metin">
                            <TextBlock Text="{Binding Ad}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding TarihMetni}" FontSize="16" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding HicriMetni}" FontSize="14" Opacity="0.78" Margin="0,1,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Margin="12,0,0,0">
                            <Border CornerRadius="10" Padding="10,2" HorizontalAlignment="Right"
                                    BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <TextBlock Text="{Binding TurMetni}" FontSize="13" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="{Binding DurumMetni}" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Siradaki}" Value="True">
                        <Setter TargetName="Vurgu" Property="Visibility" Value="Visible"/>
                        <Setter TargetName="Serit" Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Gecti}" Value="True"/>
                            <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="False"/>
                        </MultiDataTrigger.Conditions>
                        <Setter TargetName="Metin" Property="Opacity" Value="0.62"/>
                    </MultiDataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Tab sırası: liste, Önceki yıl, Bu yıl, Sonraki yıl, Kapat. Enter: o güne Takvim sekmesinde git. -->
    <Grid x:Name="Kok" Margin="24,18,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="12" Padding="18,14" Margin="0,0,0,12"
                Background="{DynamicResource AccentFillColorDefaultBrush}">
            <StackPanel>
                <TextBlock Text="Mübarek Gün ve Geceler" FontSize="26" FontWeight="SemiBold"
                           FontFamily="{StaticResource BaslikYazisi}"
                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                <TextBlock x:Name="YilYazisi" FontSize="17" Margin="0,2,0,0"
                           Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
            </StackPanel>
        </Border>

        <ListBox x:Name="Liste" Grid.Row="1" BorderThickness="0" Background="Transparent" Padding="0,0,10,0"
                 ItemTemplate="{StaticResource MubarekSablonu}"
                 ItemContainerStyle="{StaticResource MubarekOgesi}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 PreviewKeyDown="Liste_PreviewKeyDown" MouseDoubleClick="Liste_MouseDoubleClick">
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="_Panoya kopyala" InputGestureText="Ctrl+C" Click="Kopyala_Click"/>
                    <MenuItem Header="Takvim sekmesinde _göster" InputGestureText="Enter" Click="Git_Click"/>
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>

        <TextBlock x:Name="Durum" Grid.Row="2" Margin="2,8,0,8" TextWrapping="Wrap" FontWeight="SemiBold" MinHeight="22"
                   AutomationProperties.LiveSetting="Polite"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="OncekiYilDugmesi" Content="Önceki yıl" Padding="16,8" Click="OncekiYil_Click"/>
                <yerel:GecersizOlabilenDugme x:Name="BuYilDugmesi" Style="{DynamicResource DefaultButtonStyle}" Content="Bu yıl"
                            Padding="16,8" Margin="8,0,0,0" Click="BuYil_Click"/>
                <Button x:Name="SonrakiYilDugmesi" Content="Sonraki yıl" Padding="16,8" Margin="8,0,0,0" Click="SonrakiYil_Click"/>
            </StackPanel>
            <Button x:Name="KapatDugmesi" Grid.Column="2" Content="Kapat" Padding="28,8" IsCancel="True" IsDefault="False"
                    Style="{DynamicResource AccentButtonStyle}" Click="Kapat_Click"/>
        </Grid>
    </Grid>
</Window>
